---
import Typography from '@global/component/typography.astro';
import { siteConfiguration } from '@global/configuration/site_configuration';

import '../style/main.scss';

import { Seo } from 'astro-meta-engine';

import type { SeoProps } from 'astro-meta-engine';

type Props = SeoProps;

const {
  openGraph = siteConfiguration.openGraph,
  favicon = siteConfiguration.favicon,
  languageAlternative = siteConfiguration.i18n,
  metaAuthor = siteConfiguration.metaAuthor,
  ...rest
} = Astro.props;
---
<!doctype html>
<html dir='ltr' lang='es'>
  <head>
    <Seo
      favicon={favicon}
      openGraph={openGraph}
      metaAuthor={metaAuthor}
      languageAlternative={languageAlternative}
      {...rest}
    />
    <Typography />
    <slot name='head' />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import { animate } from "@global/util/animation";
  import { smoothScroll } from "@global/util/scroll";

  animate()
  smoothScroll()
</script>