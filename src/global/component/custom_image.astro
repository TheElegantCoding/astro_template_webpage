---
import { handleImage } from '@global/util/handle_image';

import Skeleton from './skeleton.astro';

import type { ImageQuality } from 'astro';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'img'> & {
  readonly src: string;
  readonly alt: string;
  readonly class?: string;
  readonly sizes?: string;
  readonly width?: number;
  readonly height?: number;
  readonly formats?: string[];
  readonly priority?: boolean;
  readonly classSkeleton?: string;
  readonly quality?: ImageQuality;
  readonly disableLoader?: boolean;
  readonly layout?: 'none' | 'fixed' | 'full-width' | 'constrained';
};

const {
  src: source,
  alt,
  sizes,
  formats = ['avif', 'webp'],
  layout,
  width,
  height,
  quality,
  priority,
  classSkeleton,
  class: classImage,
  disableLoader,
  ...rest
} = Astro.props;

const { image, sources } = await handleImage({
  source,
  sizes,
  formats,
  layout,
  quality,
  width,
  height
});
---
<Skeleton
  class='custom-image'
  visible={!disableLoader}
  class:list={classSkeleton}
>
  <slot />
  <picture data-animate={rest['data-animate']}>
    {sources.map((img) => {
      return (
        <source
          type={`image/${img.options.format}`}
          srcset={img.attributes.srcSet || img.src}
        />
      );
    })}
    <img
      alt={alt}
      src={image.src}
      class='custom-image__tag'
      class:list={[classImage]}
      width={image.attributes.width}
      height={image.attributes.height}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'auto' : 'async'}
      sizes={sizes || image.attributes.sizes}
      fetchpriority={priority ? 'high' : 'auto'}
      {...rest}
    />
  </picture>
</Skeleton>

<script>
  const skeleton = document.querySelectorAll('.custom-image');

  skeleton.forEach((item) => {
    const image = item.querySelector('img');

    const onImageError = (event: Event) => {
      const currentImage = event.currentTarget as HTMLImageElement;
      currentImage.src = image?.src as string;
    };

    const hideSkeleton = () => {
      item.classList.remove('skeleton--active');
    };

    if (image?.complete) {
      hideSkeleton();
    } else {
      image?.addEventListener('load', hideSkeleton);
      image?.addEventListener('error', onImageError);
    }
  });
</script>